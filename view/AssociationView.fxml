<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.net.*?>
<?import java.util.*?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.*?>	
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?> 
<?import javafx.geometry.*?>
<?import javafx.geometry.Insets?> 

<VBox fx:controller="controller.AssociationController" styleClass="background" 
    prefHeight="420.0" prefWidth="600.0" spacing="20" xmlns:fx="http://javafx.com/fxml/1">

    <ImageView pickOnBounds="true" preserveRatio="true" fitWidth="600">
        <image>
            <Image url="/view/NBA_Back.jpg"/>
        </image>
    </ImageView>

    <VBox>
        <padding>
            <Insets top="0" bottom="15" left="10" right="10"/>
        </padding>

        <HBox fillHeight="true">
            <Button fx:id="exploreTeamsButton" text="Explore the teams" minWidth="180" minHeight="70" HBox.hgrow="ALWAYS" onAction="#exploreTeams"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="newSeasonButton" text="Arrange a new season" minWidth="180" minHeight="70" HBox.hgrow="NEVER" onAction="#newSeason"/>
        </HBox>

        <HBox alignment="center">
            <Button fx:id="exitButton" text="Exit" minWidth="180" minHeight="70" onAction="#exit"/>
        </HBox>
    </VBox>

    <stylesheets>
        <URL value="@style.css"/>
    </stylesheets>
</VBox>