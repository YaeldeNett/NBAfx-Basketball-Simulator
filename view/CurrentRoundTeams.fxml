<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.net.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>  

<VBox fx:controller="controller.CurrentRoundTeamsController" styleClass="background"  alignment="CENTER" 
    prefHeight="300" prefWidth="400" spacing="20" xmlns:fx="http://javafx.com/fxml/1">
   
    <padding>
        <Insets top="0" bottom="15" left="10" right="10"/>
    </padding>

    <VBox alignment="CENTER">
        <Label fx:id="roundLabel" text="Round: " styleClass="label-h2"/>
    </VBox>

    <TableView fx:id="currentTeamsTable">
        <columns>
            <TableColumn fx:id="team1Col" text="Team-1" prefWidth="125.0"/>
            <TableColumn fx:id="vsCol" text="" prefWidth="100.0"/>
            <TableColumn fx:id="team2Col" text="Team-2" prefWidth="125.0"/>
        </columns>
    </TableView>

    <Button text="Close" onAction="#close"/>

    <stylesheets>
        <URL value="@style.css"/>
    </stylesheets>
</VBox>
