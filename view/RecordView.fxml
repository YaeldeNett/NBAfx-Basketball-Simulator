<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.net.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>  

<VBox fx:controller="controller.RecordController"  spacing="20" styleClass="background" alignment="CENTER" 
    prefHeight="300" prefWidth="500" xmlns:fx="http://javafx.com/fxml/1">
    
    <padding>
        <Insets top="0" bottom="15" left="10" right="10"/>
    </padding>

    <VBox alignment="CENTER">
        <Label text="Season Record" styleClass="label-h2"/>
    </VBox>

    <TableView fx:id="recordsTable">
        <columns>
            <TableColumn text="Round" prefWidth="95.0">
                <cellValueFactory>
                    <PropertyValueFactory property="round" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="Game" prefWidth="95.0">
                <cellValueFactory>
                    <PropertyValueFactory property="gameNumber" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="Winning Team" prefWidth="135.0">
                <cellValueFactory>
                    <PropertyValueFactory property="winTeam" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="Losing Team" prefWidth="135.0">
                <cellValueFactory>
                    <PropertyValueFactory property="loseTeam" />
                </cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>

    <Button fx:id="closeButton" text="Close" onAction="#close"/>
    <stylesheets>
        <URL value="@style.css"/>
    </stylesheets>
</VBox>
