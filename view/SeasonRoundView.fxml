<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.net.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>  

<VBox fx:controller="controller.TeamsRoundController"  spacing="20" styleClass="background" alignment="CENTER" 
    prefHeight="400" prefWidth="800" xmlns:fx="http://javafx.com/fxml/1">
    
    <VBox alignment="CENTER">
        <Label fx:id="roundLabel" text="Round: " styleClass="label-h2"/>
    </VBox>

    <padding>
        <Insets top="0" bottom="15" left="20" right="20"/>
    </padding>

    <HBox alignment="CENTER" spacing="10">
        <ListView fx:id="teamListView" prefHeight="250" />

        <Button fx:id="addButton" text=">>>" minWidth="180" minHeight="70" onAction="#handleAddTeamToGame"/>

        <TableView fx:id="gameTableView">
            <columns>
                <TableColumn fx:id="gameCol" text="Game" prefWidth="100.0"/>
                <TableColumn fx:id="team1Col" text="Team-1" prefWidth="100.0"/>
                <TableColumn fx:id="team2Col" text="Team-2" prefWidth="100.0"/>
            </columns>
        </TableView>
    </HBox>

    <Button fx:id="arrangeSeasonButton" text="Arrange Season" minWidth="180" minHeight="70" onAction="#arrangeRounds"/>

    <stylesheets>
        <URL value="@style.css"/>
    </stylesheets>
</VBox>
