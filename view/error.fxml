<VBox fx:controller="controller.ErrorController" alignment="center" styleClass="background" spacing="10" 
    prefHeight="300.0" prefWidth="350.0" xmlns:fx="http://javafx.com/fxml/1">

    <Label text="Message: " styleClass="label-h2"/>
    <Text fx:id="messageText" styleClass="text-out"/>
    <Button fx:id="okayButton" text="Okay" onAction="#close"/>
    
    <stylesheets>
        <URL value="@style.css"/>
    </stylesheets>
</VBox>

